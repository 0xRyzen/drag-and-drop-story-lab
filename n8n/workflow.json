      "typeVersion": 1,
      "position": [
        1330,
        420
      ],
      "parameters": {
        "command": "=node /files/dnd-story-lab/app/runtime/runner.mjs assemble {{ Buffer.from(JSON.stringify({run_id:$json.run_id})).toString('base64') }}"
      }
    },
    {
      "id": "report",
      "name": "Episode Result and Honest QA Status",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1600,
        650
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "return $input.all().map(x=>({json:{...x.json,qa_note:'Visual QA is sampled. An audio stream does not verify dialogue, voice identity, score or lip sync.'}}));"
      }
    }
